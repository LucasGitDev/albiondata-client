# Pinned tool versions — single source of truth for doctor.sh and setup.sh
# Update here first, then run `make doctor` to verify.

GO_MIN="1.24"
NODE_MIN="20"
WAILS_MIN="2.9"
GOLANGCI_LINT_VERSION="2.1.6"
JAVA_MIN="17"

# Android (mobile only — not required for desktop dev)
ANDROID_SDK_MIN_API="35"
GOMOBILE_REQUIRED="true"
ADB_REQUIRED="true"
